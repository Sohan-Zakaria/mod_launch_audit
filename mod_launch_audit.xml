<?xml version="1.0" encoding="UTF-8"?>
<extension type="module" client="administrator" method="upgrade">
    <name>MOD_LAUNCH_AUDIT</name>
    <author>Your Name or Company</author>
    <creationDate>2026-10-18</creationDate>
    <copyright>(C) 2026 Your Name or Company. All rights reserved.</copyright>
    <license>GNU General Public License version 2 or later; see LICENSE.txt</license>
    <authorEmail>admin@example.com</authorEmail>
    <authorUrl>https://example.com</authorUrl>
    <version>1.0.0</version>
    <description>MOD_LAUNCH_AUDIT_XML_DESCRIPTION</description>
    <namespace path="src">YourVendor\Module\LaunchAudit</namespace>

    <files>
        <filename module="mod_launch_audit">services/provider.php</filename>
        <filename>LICENSE.txt</filename>
        <folder>services</folder>
        <folder>src</folder>
        <folder>tmpl</folder>
    </files>

    <media destination="mod_launch_audit" folder="media">
        <filename>joomla.asset.json</filename>
        <folder>css</folder>
        <folder>js</folder>
    </media>

    <languages folder="language">
        <language tag="en-GB">en-GB/mod_launch_audit.ini</language>
        <language tag="en-GB">en-GB/mod_launch_audit.sys.ini</language>
    </languages>

    <config>
        <fields name="params">
            <fieldset name="basic">
                <field
                    name="show_score"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_LAUNCH_AUDIT_FIELD_SHOW_SCORE_LABEL"
                    description="MOD_LAUNCH_AUDIT_FIELD_SHOW_SCORE_DESC"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                    name="show_category_filter"
                    type="radio"
                    layout="joomla.form.field.radio.switcher"
                    label="MOD_LAUNCH_AUDIT_FIELD_SHOW_CATEGORY_FILTER_LABEL"
                    description="MOD_LAUNCH_AUDIT_FIELD_SHOW_CATEGORY_FILTER_DESC"
                    default="1"
                    filter="integer"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>
            </fieldset>
            <fieldset name="advanced">
                <field
                    name="layout"
                    type="modulelayout"
                    label="JFIELD_ALT_LAYOUT_LABEL"
                    class="form-select"
                />
            </fieldset>
        </fields>
    </config>

    <updateservers>
        <server type="extension" priority="1" name="Launch Audit Updates">https://example.com/updates/mod_launch_audit.xml</server>
    </updateservers>
</extension>
